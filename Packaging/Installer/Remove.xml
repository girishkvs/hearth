<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Hearth Removal</title>
    <options customize="never" require-scripts="true" rootVolumeOnly="true" hostArchitectures="@HEARTH_ARCHITECTURE@"/>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <allowed-os-versions><os-version min="13.0"/></allowed-os-versions>
    <welcome file="Remove.html" mime-type="text/html"/>
    <choices-outline><line choice="remove"/></choices-outline>
    <choice id="remove" visible="false"><pkg-ref id="dev.girishkvs.hearth.remove"/></choice>
    <pkg-ref id="dev.girishkvs.hearth.remove" auth="Root">Hearth-Remove-Component.pkg</pkg-ref>
</installer-gui-script>
